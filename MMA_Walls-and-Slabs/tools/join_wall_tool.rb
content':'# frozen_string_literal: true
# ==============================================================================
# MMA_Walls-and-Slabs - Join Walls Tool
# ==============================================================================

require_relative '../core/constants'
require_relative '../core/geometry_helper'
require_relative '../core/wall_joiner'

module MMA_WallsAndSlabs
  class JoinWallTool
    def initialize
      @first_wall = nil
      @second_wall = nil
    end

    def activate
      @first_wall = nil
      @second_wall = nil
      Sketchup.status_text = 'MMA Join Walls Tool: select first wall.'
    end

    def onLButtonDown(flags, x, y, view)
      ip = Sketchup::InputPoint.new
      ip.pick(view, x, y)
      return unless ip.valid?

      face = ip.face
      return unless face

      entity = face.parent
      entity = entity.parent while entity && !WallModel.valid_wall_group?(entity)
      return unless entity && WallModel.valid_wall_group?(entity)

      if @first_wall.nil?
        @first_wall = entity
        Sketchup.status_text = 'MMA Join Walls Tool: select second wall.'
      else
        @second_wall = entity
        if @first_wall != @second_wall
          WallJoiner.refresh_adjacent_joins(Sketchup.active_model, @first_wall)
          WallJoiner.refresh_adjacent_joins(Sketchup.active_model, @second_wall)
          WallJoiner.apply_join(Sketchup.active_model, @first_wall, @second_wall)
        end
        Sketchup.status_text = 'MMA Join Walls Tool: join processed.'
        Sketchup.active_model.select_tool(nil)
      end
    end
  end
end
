# MMA_Walls-and-Slabs - Opening Tool
# ==============================================================================

require_relative '../core/constants'
require_relative '../core/opening_cutter'

module MMA_WallsAndSlabs
  class OpeningTool
    def initialize(options = {})
      @options = options || {}
      @ip = Sketchup::InputPoint.new
      @target_wall = nil
    end

    def activate
      Sketchup.status_text = 'MMA Opening Tool: select a wall to place the opening.'
    end

    def onMouseMove(flags, x, y, view)
      @ip.pick(view, x, y)
      view.invalidate
    end

    def onLButtonDown(flags, x, y, view)
      @ip.pick(view, x, y)
      return unless @ip.valid?

      face = @ip.face
      return unless face

      parent = face.parent
      return unless parent && parent.valid?

      wall_group = parent
      wall_group = parent.parent while wall_group && !WallModel.valid_wall_group?(wall_group)
      return unless wall_group && WallModel.valid_wall_group?(wall_group)

      opening = { 'type' => @options['type'] || 'door', 'width' => (@options['width'] || 900).to_f, 'height' => (@options['height'] || 2100).to_f, 'sill_height' => (@options['sill_height'] || 0).to_f }
      OpeningCutter.add_wall_opening(Sketchup.active_model, wall_group, opening)
      Sketchup.status_text = 'MMA Opening Tool: opening placed.'
      Sketchup.active_model.select_tool(nil)
    end
  end
end
