content':'let currentWallData = {
  height: 2800,
  justification: 'center',
  core_type: 'poroton',
  core_thickness: 250,
  core_material: 'EWS_Laterizio',
  ext_layers: [
    { name: 'Intonaco esterno', thickness: 15, material: 'EWS_Render_Ext', enabled: true },
    { name: 'Cappotto EPS', thickness: 100, material: 'EWS_Insulation_EPS', enabled: true }
  ],
  int_layers: [
    { name: 'Intonaco interno', thickness: 15, material: 'EWS_Plaster_Int', enabled: true }
  ],
  openings: []
};

function collectLayerRows(containerId) {
  return Array.from(document.querySelectorAll('#' + containerId + ' .layer-row')).map((row) => ({
    name: row.querySelector('.layer-name').value || 'Layer',
    thickness: Number(row.querySelector('.layer-thickness').value || 0),
    material: row.querySelector('.layer-material').value || 'EWS_Concrete',
    enabled: row.querySelector('.layer-enabled').checked
  }));
}

function renderLayerList(side, layers) {
  const target = document.getElementById(side + '-layers');
  if (!target) return;

  target.innerHTML = '';

  layers.forEach((layer) => {
    const row = document.createElement('div');
    row.className = 'layer-row';

    row.innerHTML = `
      <input class="layer-name" type="text" value="${layer.name || 'Layer'}">
      <input class="layer-thickness" type="number" min="0" step="1" value="${Number(layer.thickness || 0)}">
      <select class="layer-material">
        <option value="EWS_Render_Ext" ${layer.material === 'EWS_Render_Ext' ? 'selected' : ''}>Render Ext</option>
        <option value="EWS_Insulation_EPS" ${layer.material === 'EWS_Insulation_EPS' ? 'selected' : ''}>EPS</option>
        <option value="EWS_Plaster_Int" ${layer.material === 'EWS_Plaster_Int' ? 'selected' : ''}>Plaster Int</option>
        <option value="EWS_Concrete" ${layer.material === 'EWS_Concrete' ? 'selected' : ''}>Concrete</option>
        <option value="EWS_Laterizio" ${layer.material === 'EWS_Laterizio' ? 'selected' : ''}>Laterizio</option>
        <option value="EWS_Brick" ${layer.material === 'EWS_Brick' ? 'selected' : ''}>Brick</option>
        <option value="EWS_Ytong" ${layer.material === 'EWS_Ytong' ? 'selected' : ''}>AAC</option>
        <option value="EWS_Drywall_Board" ${layer.material === 'EWS_Drywall_Board' ? 'selected' : ''}>Drywall</option>
      </select>
      <label class="layer-enabled-wrap"><input class="layer-enabled" type="checkbox" ${layer.enabled ? 'checked' : ''}> On</label>
    `;

    target.appendChild(row);
  });
}

function renderLayers() {
  renderLayerList('ext', currentWallData.ext_layers || []);
  renderLayerList('int', currentWallData.int_layers || []);
}

function applyPreset(key) {
  switch (key) {
    case 'ext_laterizio_cappotto':
      currentWallData.core_type = 'poroton';
      currentWallData.core_thickness = 250;
      currentWallData.core_material = 'EWS_Laterizio';
      currentWallData.ext_layers = [
        { name: 'Intonaco esterno', thickness: 15, material: 'EWS_Render_Ext', enabled: true },
        { name: 'Cappotto EPS', thickness: 100, material: 'EWS_Insulation_EPS', enabled: true }
      ];
      currentWallData.int_layers = [{ name: 'Intonaco interno', thickness: 15, material: 'EWS_Plaster_Int', enabled: true }];
      break;
    case 'ext_concrete_cappotto':
      currentWallData.core_type = 'concrete';
      currentWallData.core_thickness = 250;
      currentWallData.core_material = 'EWS_Concrete';
      currentWallData.ext_layers = [
        { name: 'Intonaco esterno', thickness: 15, material: 'EWS_Render_Ext', enabled: true },
        { name: 'Cappotto EPS', thickness: 140, material: 'EWS_Insulation_EPS', enabled: true }
      ];
      currentWallData.int_layers = [{ name: 'Intonaco interno', thickness: 15, material: 'EWS_Plaster_Int', enabled: true }];
      break;
    case 'int_laterizio':
      currentWallData.core_type = 'poroton';
      currentWallData.core_thickness = 80;
      currentWallData.core_material = 'EWS_Laterizio';
      currentWallData.ext_layers = [{ name: 'Intonaco', thickness: 15, material: 'EWS_Plaster_Int', enabled: true }];
      currentWallData.int_layers = [{ name: 'Intonaco', thickness: 15, material: 'EWS_Plaster_Int', enabled: true }];
      break;
    case 'drywall_double':
      currentWallData.core_type = 'drywall';
      currentWallData.core_thickness = 75;
      currentWallData.core_material = 'EWS_Drywall_Board';
      currentWallData.ext_layers = [];
      currentWallData.int_layers = [];
      break;
    default:
      break;
  }

  document.getElementById('wall-height').value = currentWallData.height;
  document.getElementById('wall-justification').value = currentWallData.justification;
  document.getElementById('core-type').value = currentWallData.core_type;
  document.getElementById('core-thickness').value = currentWallData.core_thickness;
  document.getElementById('core-material').value = currentWallData.core_material;
  renderLayers();
}

function closeDialog() {
  window.location = 'skp:close_dialog@';
}

function submitWall() {
  currentWallData.height = Number(document.getElementById('wall-height').value || 2800);
  currentWallData.justification = document.getElementById('wall-justification').value || 'center';
  currentWallData.core_type = document.getElementById('core-type').value || 'poroton';
  currentWallData.core_thickness = Number(document.getElementById('core-thickness').value || 250);
  currentWallData.core_material = document.getElementById('core-material').value || 'EWS_Laterizio';
  currentWallData.ext_layers = collectLayerRows('ext-layers');
  currentWallData.int_layers = collectLayerRows('int-layers');

  window.location = 'skp:create_or_update_wall@' + encodeURIComponent(JSON.stringify(currentWallData));
}

window.addEventListener('DOMContentLoaded', () => {
  document.getElementById('wall-height').value = currentWallData.height || 2800;
  document.getElementById('wall-justification').value = currentWallData.justification || 'center';
  document.getElementById('core-type').value = currentWallData.core_type || 'poroton';
  document.getElementById('core-thickness').value = currentWallData.core_thickness || 250;
  document.getElementById('core-material').value = currentWallData.core_material || 'EWS_Laterizio';
  renderLayers();
});
